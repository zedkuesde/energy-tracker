# Example only: never put real secrets in this file.
# Vite (dev): http://localhost:5173 — proxies /api and /health to Fastify.
# Fastify: APP_PORT (default 3000), APP_HOST (default 127.0.0.1).

# --- Développement local (npm run dev / npm start) ---
DATABASE_PATH=./data/energy-tracker.sqlite
APP_PORT=3000
APP_HOST=127.0.0.1

# Hash Argon2id du mot de passe unique. Ne jamais mettre une vraie valeur ici.
AUTH_PASSWORD_HASH=

# Secret long et aléatoire pour signer le cookie de session.
# Ne jamais mettre une vraie valeur ici.
AUTH_SESSION_SECRET=

# En développement local HTTP : false.
# En production HTTPS derrière reverse proxy : true (obligatoire).
AUTH_COOKIE_SECURE=false

# Durée maximale de session en secondes (14 jours par défaut).
AUTH_SESSION_TTL_SECONDS=1209600

# false en local. true uniquement derrière un reverse proxy de confiance
# qui est le seul à joindre Fastify. Ne pas l’activer si le port Fastify
# est joignable publiquement.
TRUST_PROXY=false

# --- Production Docker / VPS ---
# Copier ce fichier vers .env sur le VPS, puis coller AUTH_PASSWORD_HASH
# et AUTH_SESSION_SECRET générés localement (npm run auth:hash / auth:secret).
# Ne jamais commiter ce fichier rempli.
#
# docker compose définit déjà NODE_ENV, APP_PORT, APP_HOST et DATABASE_PATH.
# Sur le VPS, activer :
#
# NODE_ENV=production
# APP_PORT=3000
# APP_HOST=0.0.0.0
# DATABASE_PATH=/data/energy-tracker.sqlite
# AUTH_COOKIE_SECURE=true
# TRUST_PROXY=true
# AUTH_SESSION_TTL_SECONDS=1209600
# AUTH_PASSWORD_HASH=
# AUTH_SESSION_SECRET=
