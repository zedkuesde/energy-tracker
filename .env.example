# Example only: never put real secrets in this file.
# Vite (dev): http://localhost:5173 — proxies /api and /health to Fastify.
# Fastify: APP_PORT (default 3000), APP_HOST (default 127.0.0.1).

# --- Développement local (npm run dev / npm start) ---
DATABASE_PATH=./data/energy-tracker.sqlite
APP_PORT=3000
APP_HOST=127.0.0.1

# Email du compte propriétaire. Uniquement pour la migration 003_multi_account.
# Ne jamais mettre une vraie valeur ici.
AUTH_OWNER_EMAIL=

# Hash Argon2id du mot de passe actuel du propriétaire.
# Uniquement pour la migration 003_multi_account (copie vers users.password_hash).
# Après 003, le login ne lit plus cette variable. La modifier ne change pas le mot de passe.
# Ne jamais mettre une vraie valeur ici.
AUTH_PASSWORD_HASH=

# Secret long et aléatoire pour signer le cookie de session (obligatoire au démarrage).
# Ne jamais mettre une vraie valeur ici.
AUTH_SESSION_SECRET=

# En développement local HTTP : false.
# En production HTTPS derrière reverse proxy : true (obligatoire).
AUTH_COOKIE_SECURE=false

# Durée maximale de session en secondes (14 jours par défaut).
AUTH_SESSION_TTL_SECONDS=1209600

# false en local. true uniquement derrière un reverse proxy de confiance
# qui est le seul à joindre Fastify. Ne pas l’activer si le port Fastify
# est joignable publiquement.
TRUST_PROXY=false

# --- Production Docker / VPS ---
# Copier ce fichier vers .env sur le VPS.
# Ne jamais commiter ce fichier rempli.
#
# docker compose définit déjà NODE_ENV, APP_PORT, APP_HOST et DATABASE_PATH.
# Sur le VPS, activer :
#
# NODE_ENV=production
# APP_PORT=3000
# APP_HOST=0.0.0.0
# DATABASE_PATH=/data/energy-tracker.sqlite
# AUTH_COOKIE_SECURE=true
# TRUST_PROXY=true
# AUTH_SESSION_TTL_SECONDS=1209600
# AUTH_SESSION_SECRET=
#
# Avant d’appliquer 003_multi_account uniquement :
# AUTH_OWNER_EMAIL=
# AUTH_PASSWORD_HASH=
#
# Après 003, AUTH_PASSWORD_HASH n’est plus utilisé au login.
