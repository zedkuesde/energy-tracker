# Example only: never put real secrets in this file.
# Vite (dev): http://localhost:5173 — proxies /api and /health to Fastify.
# Fastify: APP_PORT (default 3000).
DATABASE_PATH=./data/energy-tracker.sqlite
APP_PORT=3000

# Hash Argon2id du mot de passe unique. Ne jamais mettre une vraie valeur ici.
AUTH_PASSWORD_HASH=

# Secret long et aléatoire pour signer le cookie de session.
# Ne jamais mettre une vraie valeur ici.
AUTH_SESSION_SECRET=

# En développement local HTTP : false.
# En production HTTPS derrière reverse proxy : true.
AUTH_COOKIE_SECURE=false

# Durée maximale de session en secondes (14 jours par défaut).
AUTH_SESSION_TTL_SECONDS=1209600

# false en local. true uniquement plus tard, derrière un reverse proxy
# qui est le seul à joindre Fastify (Jalon Docker/VPS).
TRUST_PROXY=false
